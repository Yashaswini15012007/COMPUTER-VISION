      "source": [
        "import cv2\n",
        "import numpy as np\n",
        "from google.colab.patches import cv2_imshow\n",
        "\n",
        "# Create a dummy image.jpg if it doesn't exist so the code runs successfully\n",
        "try:\n",
        "    img = cv2.imread(\"image.jpg\")\n",
        "    if img is None:\n",
        "        # Create a simple 300x300 blue image with some text as a placeholder\n",
        "        img = np.zeros((300, 300, 3), dtype=np.uint8)\n",
        "        cv2.rectangle(img, (50, 50), (250, 250), (255, 0, 0), -1)\n",
        "        cv2.putText(img, 'F', (120, 180), cv2.FONT_HERSHEY_SIMPLEX, 4, (255, 255, 255), 5)\n",
        "        cv2.imwrite(\"image.jpg\", img)\n",
        "        print(\"Created a sample 'image.jpg' for demonstration.\")\n",
        "except Exception as e:\n",
        "    pass\n",
        "\n",
        "# Reload and process the image\n",
        "img = cv2.imread(\"image.jpg\")\n",
        "\n",
        "if img is None:\n",
        "    print(\"Image not found\")\n",
        "else:\n",
        "    rotated = cv2.rotate(img, cv2.ROTATE_90_CLOCKWISE)\n",
        "\n",
        "    print(\"Original Image:\")\n",
        "    cv2_imshow(img)\n",
        "\n",
        "    print(\"\\n90 Degree Clockwise:\")\n",
        "    cv2_imshow(rotated)"
      ]
